# Files Vercel does NOT publish. They stay in the GitHub repo; they just aren't served on the website.
# The site only needs: index.html, runtime/, dict/, ext/, more/, seeds/, level.json
tests/
tools/
server/
src/
docs/
close-reader.html
# per-letter dictionary sources: the page reads the small buckets in dict/b/ and more/b/ instead
dict/[a-z].json
more/[a-z].json
*.md
.gitignore
